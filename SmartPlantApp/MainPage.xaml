<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SmartPlantApp.MainPage"
             Title="Smart Plant">

    <VerticalStackLayout
        Padding="30"
        Spacing="24">

        <Label
            Text="Smart Plant"
            FontSize="32"
            FontAttributes="Bold"
            HorizontalOptions="Center" />

        <Label
            Text="Bodemvocht"
            FontSize="20" />

        <Label
            x:Name="MoistureLabel"
            Text="--"
            FontSize="36"
            FontAttributes="Bold" />

        <Label
            Text="Temperatuur"
            FontSize="20" />

        <Label
            x:Name="TemperatureLabel"
            Text="-- °C"
            FontSize="36"
            FontAttributes="Bold" />

    </VerticalStackLayout>

</ContentPage>
