<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SmartPlantApp.MainPage"
             Title="Smart Plant">

    <ScrollView>
        <VerticalStackLayout
            Padding="30"
            Spacing="24">

            <Label
                Text="Smart Plant"
                FontSize="32"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <Label
                Text="Bodemvocht"
                FontSize="20" />

            <Label
                x:Name="MoistureLabel"
                Text="--"
                FontSize="36"
                FontAttributes="Bold" />

            <Label
                Text="Temperatuur"
                FontSize="20" />

            <Label
                x:Name="TemperatureLabel"
                Text="-- °C"
                FontSize="36"
                FontAttributes="Bold" />

            <Label
                Text="Historie"
                FontSize="28"
                FontAttributes="Bold"
                Margin="0,20,0,0" />

            <Button
                Text="Historie vernieuwen"
                Clicked="OnRefreshHistoryClicked" />

            <Label
                Text="Recente metingen"
                FontSize="20"
                FontAttributes="Bold" />

            <VerticalStackLayout
                x:Name="ReadingsHistoryLayout"
                Spacing="8" />

            <Label
                Text="Waterbeurten"
                FontSize="20"
                FontAttributes="Bold"
                Margin="0,16,0,0" />

            <VerticalStackLayout
                x:Name="WateringHistoryLayout"
                Spacing="8" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
